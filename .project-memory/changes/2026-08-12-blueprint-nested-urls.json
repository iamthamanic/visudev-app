  "title": {
    "de": "Blueprint-Views als nested Paths",
    "en": "Blueprint views as nested paths"
  },
  "summary": {
    "de": "Canonical-URL /blueprint/<view> statt Query ?view=; Legacy-Bookmarks werden umgeschrieben.",
    "en": "Canonical URL /blueprint/<view> instead of query ?view=; legacy bookmarks are rewritten."
  },
  "plain_language": {
    "de": "Jeder Blueprint-Tab hat jetzt eine eigene Adresse wie /blueprint/atlas, nicht mehr einen Parameter in der URL.",
    "en": "Each Blueprint tab now has its own address like /blueprint/atlas, not a query parameter."
  },
  "why_it_matters": {
    "de": "Pfade sind teilbar, lesbar und passen zur Sidebar-Hierarchie.",
    "en": "Paths are shareable, readable, and match the sidebar hierarchy."
  },
  "user_impact": {
    "de": [
      "Adressleiste zeigt /blueprint/atlas statt /blueprint?view=atlas",
      "Alte ?view=-Links werden automatisch umgeleitet"
    ],
    "en": [
      "Address bar shows /blueprint/atlas instead of /blueprint?view=atlas",
      "Old ?view= links redirect automatically"
    ]
  },
  "developer_impact": {
    "de": [
      "Shell pathnameToScreen nutzt nur das erste Segment",
      "blueprintViewPath und parseBlueprintViewFromLocation"
    ],
    "en": [
      "Shell pathnameToScreen uses only the first segment",
      "blueprintViewPath and parseBlueprintViewFromLocation"
    ]
  },
